{
  "name": "xanderpuzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 3D environmental gravity-puzzle game built with Babylon.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.2",
    "@babylonjs/gui": "^7.54.2",
    "@babylonjs/materials": "^7.54.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
